{{!
    @template mod_videopredict/player

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-videopredict" data-region="videopredict-root" data-cmid="{{cmid}}" data-source="{{videosource}}"
     data-url="{{videourl}}" data-poster="{{poster}}">
    {{#intro}}
        <div class="videopredict-intro mb-3">{{{intro}}}</div>{{/intro}}
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <strong>{{#str}}yourprogress, videopredict{{/str}}:</strong>
            <span data-region="progress-percent">{{percent}}%</span>
        </div>
        <div>
            {{#manageurl}}<a class="btn btn-secondary btn-sm" href="{{{manageurl}}}">{{#str}}
                managepoints, videopredict{{/str}}</a>{{/manageurl}}
            {{#reporturl}}<a class="btn btn-secondary btn-sm" href="{{{reporturl}}}">{{#str}}
                reporttitle, videopredict{{/str}}</a>{{/reporturl}}
        </div>
    </div>

    <div class="videopredict-player-shell position-relative mb-3" data-region="player-shell">
        <div class="ratio ratio-16x9 bg-dark" data-region="player-container">
            <video class="w-100 h-100" data-region="html5-player" controls preload="metadata" playsinline
                   hidden></video>
            <div class="w-100 h-100" data-region="iframe-player" hidden></div>
        </div>
        <div class="videopredict-timeline" data-region="timeline" aria-label="{{#str}}timeline, videopredict{{/str}}">
            {{#points}}
                <button type="button"
                        class="videopredict-marker {{#answered}}is-answered{{/answered}} {{#required}}is-required{{/required}}"
                        data-point-id="{{id}}" data-time="{{timeposition}}" style="--point-time: {{timeposition}}s"
                        title="{{timeformatted}} — {{title}}"><span class="visually-hidden">{{timeformatted}}
                    — {{title}}</span></button>
            {{/points}}
        </div>
    </div>

    <div class="card">
        <div class="card-header"><strong>{{#str}}predictionpoints, videopredict{{/str}}</strong></div>
        <div class="list-group list-group-flush" data-region="point-list">
            {{#points}}
                <div class="list-group-item d-flex justify-content-between align-items-center"
                     data-point-summary="{{id}}">
                    <div><strong>{{timeformatted}}</strong> — {{title}}</div>
                    <span class="badge {{#answered}}bg-success{{/answered}}{{^answered}}bg-secondary{{/answered}}"
                          data-region="point-status">{{#answered}}{{#str}}
                        answered, videopredict{{/str}}{{/answered}}{{^answered}}{{#str}}
                        pending, videopredict{{/str}}{{/answered}}</span>
                </div>
            {{/points}}
            {{^points}}
                <div class="list-group-item text-muted">{{#str}}nopoints, videopredict{{/str}}</div>{{/points}}
        </div>
    </div>

    <div class="modal fade" tabindex="-1" data-region="prediction-modal" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-region="modal-title"></h5>
                    <button type="button" class="btn-close" data-region="modal-close"
                            aria-label="{{#str}}closebuttontitle{{/str}}"></button>
                </div>
                <div class="modal-body">
                    <div data-region="prediction-step">
                        <div class="mb-3" data-region="prediction-question"></div>
                        <div class="mb-3" data-region="prediction-input"></div>
                        <div class="small text-muted" data-region="locked-notice"></div>
                    </div>
                    <div data-region="result-step" hidden>
                        <div class="alert alert-info" data-region="original-answer"></div>
                        <div class="mb-3" data-region="correctness"></div>
                        <div class="mb-3" data-region="result-text"></div>
                        <div data-region="reflection-area" hidden>
                            <hr>
                            <div class="mb-2" data-region="reflection-question"></div>
                            <textarea class="form-control mb-3" rows="4" data-region="reflection-text"></textarea>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="understandingchanged" value="1"
                                       id="videopredict-changed-yes">
                                <label class="form-check-label" for="videopredict-changed-yes"
                                       data-region="changed-yes"></label>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="radio" name="understandingchanged" value="0"
                                       id="videopredict-changed-no">
                                <label class="form-check-label" for="videopredict-changed-no"
                                       data-region="changed-no"></label>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-danger" data-region="modal-error" hidden></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-region="continue-button" hidden></button>
                    <button type="button" class="btn btn-primary" data-region="submit-prediction"></button>
                    <button type="button" class="btn btn-primary" data-region="submit-reflection" hidden></button>
                </div>
            </div>
        </div>
    </div>
</div>
